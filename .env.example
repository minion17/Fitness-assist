# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Токен от @BotFather
BOT_TOKEN=

# Публичный HTTPS-адрес Mini App (туннель cloudflared/ngrok или домен)
WEBAPP_URL=https://example.trycloudflare.com

# PostgreSQL (совпадает с docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://fitness:fitness@localhost:5432/fitness

# Через запятую; "*" — для разработки
CORS_ORIGINS=*

# Срок жизни initData в секундах
INIT_DATA_MAX_AGE=86400
